@* A build's totals: defense, weight, resistances, and per-weapon damage with the bonuses that feed it. *@

<section class="card">
    <h2>Character</h2>
    <dl class="stats">
        <dt>Health</dt><dd>@Stats.Health.ToString("0")</dd>
        <dt>Stamina</dt><dd>@(Stats.Stamina > 9999 ? "Unlimited" : Stats.Stamina.ToString("0"))</dd>
        <dt>Armor</dt><dd>@Stats.Armor.ToString("0.#") <span class="muted small">(@Pct(Stats.ArmorReduction) damage reduction)</span></dd>
        <dt>Damage reduction</dt><dd>@Pct(Stats.TotalReduction)@(Stats.FlatReduction > 0 ? $" (armor plus {Pct(Stats.FlatReduction)} from effects)" : "")</dd>
        <dt>Weight</dt><dd>@Stats.Weight.ToString("0.#") · <b>@Stats.WeightClass</b> <span class="muted small">@BuildCalculator.WeightClassEffect(Stats.WeightClass)@(Stats.WeightThreshold != 0 ? $", thresholds moved {Stats.WeightThreshold:+0.#;-0.#}" : "")</span></dd>
        @foreach (var (element, value) in Stats.Resistances)
        {
            <dt>@element resistance</dt><dd>@value.ToString("0.#")</dd>
        }
    </dl>
</section>

<section class="card">
    <h2>Damage</h2>
    <div class="row">
        <label class="muted small" for="weakspot">Weakspot hits: @Pct(Build.WeakspotHitRate)</label>
        <input id="weakspot" type="range" min="0" max="100" step="5" value="@(Build.WeakspotHitRate * 100)" @onchange="WeakspotChanged" />
    </div>
    @if (Stats.Weapons.Count == 0)
    {
        <p class="muted">Pick a weapon on the Build tab.</p>
    }
    @foreach (var w in Stats.Weapons)
    {
        <div class="weapon">
            <h3>@w.Weapon.Name <span class="muted small">+@w.Slot.Level · @w.BaseAtLevel.ToString("0.#") base</span></h3>
            @if (w.DpsMin is { } min)
            {
                <dl class="stats">
                    <dt>DPS range</dt><dd>@min.ToString("0") – @w.DpsMax!.Value.ToString("0")</dd>
                    <dt>Expected DPS</dt><dd><b>@w.DpsExpected!.Value.ToString("0")</b></dd>
                    <dt>Per shot</dt><dd>@w.HitMin.ToString("0") body · @w.HitExpected.ToString("0") expected · @w.HitMax.ToString("0") weakspot crit</dd>
                    <dt>Shots per second</dt><dd>@w.ShotsPerSecond!.Value.ToString("0.##")@(w.FireRateBonus != 0 ? $" ({w.FireRateBonus:+0%;-0%} fire rate)" : "")</dd>
                </dl>
            }
            else
            {
                <dl class="stats">
                    <dt>Per hit</dt><dd>@w.HitMin.ToString("0") – @w.HitMax.ToString("0")</dd>
                    <dt>Expected per hit</dt><dd><b>@w.HitExpected.ToString("0")</b></dd>
                </dl>
                <p class="muted small">Melee DPS needs attack speeds, which the item data doesn't have.</p>
            }
            <p class="muted small">
                Damage bonus @w.DamageBonus.ToString("+0.#%;-0.#%") · crit chance @Pct(w.CritChance) · crit hits ×@w.CritMultiplier.ToString("0.##")
                · weakspot ×@w.WeakspotMultiplier.ToString("0.##")
            </p>
        </div>
    }
    <p class="muted small">Burst damage while firing, without reloads. Min is body shots with no crits; max is every shot a
       weakspot crit; expected uses the crit chance and the weakspot slider.</p>
</section>

<section class="card">
    <h2>Effects</h2>
    @if (Stats.Effects.Count == 0)
    {
        <p class="muted">No damage or damage reduction bonuses read from the picked items yet.</p>
    }
    <ul class="effects">
        @foreach (var e in Stats.Effects)
        {
            var effect = e.Effect;
            <li>
                <label class="toggle">
                    <input type="checkbox" checked="@e.On" @onchange="() => Flip(effect.Key)" />
                    <span><b>@effect.Label @effect.Value.ToString("+0.#%;-0.#%")</b> <span class="muted small">@effect.Source.Name@(effect.WeaponOnly ? " (its weapon only)" : "")@(effect.Conditional ? " · situational" : "")</span></span>
                </label>
                <p class="muted small">@effect.Text</p>
            </li>
        }
    </ul>
    <p class="muted small">Read from each item's description. Situational ones start off; tick the ones you'll keep up.
       Anything not listed (status effects, mods, skills) isn't counted.</p>
</section>

@code {
    [Parameter, EditorRequired] public Build Build { get; set; } = null!;
    [Parameter, EditorRequired] public BuildStats Stats { get; set; } = null!;
    [Parameter] public EventCallback OnChange { get; set; }

    private static string Pct(double value) => value.ToString("0.#%");

    private Task WeakspotChanged(ChangeEventArgs e)
    {
        Build.WeakspotHitRate = double.Parse((string)e.Value!, System.Globalization.CultureInfo.InvariantCulture) / 100;
        return OnChange.InvokeAsync();
    }

    private Task Flip(string key)
    {
        if (!Build.FlippedEffects.Remove(key)) Build.FlippedEffects.Add(key);
        return OnChange.InvokeAsync();
    }
}
