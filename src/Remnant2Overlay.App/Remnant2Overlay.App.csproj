<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Lets the project build (not run) on non-Windows machines and CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced directly (not only through the library projects) so the DLLs are always copied next to the
         app; some Visual Studio builds don't flow transitive package references, which fails at run time. -->
    <PackageReference Include="CUE4Parse" Version="$(CUE4ParseVersion)" />
    <PackageReference Include="CUE4Parse-Conversion" Version="$(CUE4ParseVersion)" />
    <PackageReference Include="lib.remnant2.analyzer" Version="$(RemnantAnalyzerVersion)" />
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remnant2Overlay.SaveReader\Remnant2Overlay.SaveReader.csproj" />
    <ProjectReference Include="..\Remnant2Overlay.Icons\Remnant2Overlay.Icons.csproj" />
    <ProjectReference Include="..\Remnant2Overlay.Sync\Remnant2Overlay.Sync.csproj" />
  </ItemGroup>

</Project>
