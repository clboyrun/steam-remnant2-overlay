<Window x:Class="Remnant2Overlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Remnant2Overlay.App"
        xmlns:sr="clr-namespace:Remnant2Overlay.SaveReader;assembly=Remnant2Overlay.SaveReader"
        Title="Remnant 2 Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        MinWidth="420" MinHeight="300"
        FontFamily="Segoe UI" FontSize="13" Foreground="#E8E2D6">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1A1815" />
        <SolidColorBrush x:Key="PanelLight" Color="#2A2621" />
        <SolidColorBrush x:Key="Accent" Color="#C9A45C" />
        <SolidColorBrush x:Key="OwnedBrush" Color="#5FAF6A" />
        <SolidColorBrush x:Key="MissingBrush" Color="#D2553F" />
        <SolidColorBrush x:Key="Muted" Color="#9A9286" />
        <SolidColorBrush x:Key="AvailableBrush" Color="#E0B54A" />
        <SolidColorBrush x:Key="QuestBrush" Color="#9C7BD9" />
        <SolidColorBrush x:Key="NotHereBrush" Color="#4A453E" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E2D6" />
            <Setter Property="Background" Value="{StaticResource PanelLight}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A342C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:ItemTileViewModel}">
            <Border x:Name="Tile" Width="96" Height="118" Margin="4" CornerRadius="6"
                    Background="{StaticResource PanelLight}" BorderThickness="2"
                    BorderBrush="{StaticResource NotHereBrush}" ToolTip="{Binding Tooltip}"
                    Cursor="Hand" MouseLeftButtonUp="Tile_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Art" Margin="8,8,8,2">
                        <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Initials}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="11" Margin="4,0,4,6" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ManualMark" Text="✎" FontSize="11" Margin="0,3,5,0" Visibility="Collapsed"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Accent}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="{x:Static sr:RunItemStatus.Owned}">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource OwnedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="{x:Static sr:RunItemStatus.Available}">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AvailableBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="{x:Static sr:RunItemStatus.NeedsPrerequisite}">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource QuestBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="{x:Static sr:RunItemStatus.MissedThisRun}">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource MissingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Owned}" Value="False">
                    <Setter TargetName="Art" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsManual}" Value="True">
                    <Setter TargetName="ManualMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource Panel}" CornerRadius="8"
            BorderBrush="#3A342C" BorderThickness="1" Opacity="{Binding Value, ElementName=OpacitySlider}">
        <DockPanel Margin="10">

            <!-- Title bar: drag to move -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="REMNANT 2 OVERLAY" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding Summary}" Margin="12,0,0,0" Foreground="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0" />
                    <Slider x:Name="OpacitySlider" Width="80" Minimum="0.3" Maximum="1" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="—" Style="{StaticResource FlatButton}" Click="Minimize_Click" ToolTip="Hide (Ctrl+Shift+O to show)" />
                    <Button Content="✕" Style="{StaticResource FlatButton}" Margin="0" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Filters -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding CharacterNames}" SelectedIndex="{Binding CharacterIndex}" ToolTip="Character" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Label" />
                <ComboBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding World}" DisplayMemberPath="Label" MinWidth="130"
                          ToolTip="World. In manual mode, pick the adventure you rolled." />
                <ComboBox ItemsSource="{Binding ShowOptions}" SelectedItem="{Binding Show}" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,6,0"
                         Background="{StaticResource PanelLight}" Foreground="#E8E2D6" BorderThickness="0" Padding="4"
                         ToolTip="Search by item name or where it drops" />
            </WrapPanel>

            <!-- Run: which roll, summary banner, quest status -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Run}" DisplayMemberPath="Label" MinWidth="220"
                              ToolTip="Campaign or adventure to plan for" />
                    <ToggleButton Content="Run map" IsChecked="{Binding ShowRunView}" Padding="10,2"
                                  ToolTip="Show the rolled worlds, locations and drop sources" />
                </WrapPanel>
                <Border Margin="0,6,0,0" Padding="8,5" CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2E2A22" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NothingLeft}" Value="True">
                                    <Setter Property="Background" Value="#4A2420" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding RunSummary}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding QuestStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Legend -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <WrapPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Margin" Value="0,0,12,0" />
                    </Style>
                </WrapPanel.Resources>
                <TextBlock Text="■ owned" Foreground="{StaticResource OwnedBrush}" />
                <TextBlock Text="■ available this run" Foreground="{StaticResource AvailableBrush}" />
                <TextBlock Text="■ needs quest/unlock" Foreground="{StaticResource QuestBrush}" />
                <TextBlock Text="■ missed this run" Foreground="{StaticResource MissingBrush}" />
                <TextBlock Text="■ not in this run" Foreground="{StaticResource Muted}" />
            </WrapPanel>

            <!-- Status bar -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,14,0">
                    <ToggleButton Content="Manual mode" IsChecked="{Binding ManualMode}" Padding="10,4" Margin="0,0,6,0"
                                  ToolTip="Click tiles to mark them owned or missing yourself" />
                    <Button Content="Clear manual" Style="{StaticResource FlatButton}" Click="ClearManual_Click" />
                    <Button Content="Open save…" Style="{StaticResource FlatButton}" Click="OpenSave_Click" />
                    <Button Content="Reload" Style="{StaticResource FlatButton}" Click="Reload_Click" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Grid>
            <TreeView ItemsSource="{Binding RunTree}" Background="Transparent" BorderThickness="0"
                      Visibility="{Binding ShowRunView, Converter={StaticResource BoolToVis}}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Foreground" Value="#E8E2D6" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:RunNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock x:Name="Dot" Text="● " Visibility="Collapsed" />
                            <TextBlock Text="{Binding Title}" Foreground="#E8E2D6" />
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static sr:RunItemStatus.Available}">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource AvailableBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static sr:RunItemStatus.NeedsPrerequisite}">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource QuestBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static sr:RunItemStatus.MissedThisRun}">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource MissingBrush}" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRunView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource TileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
