<Window x:Class="Remnant2Overlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Remnant2Overlay.App"
        Title="Remnant 2 Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        MinWidth="420" MinHeight="300"
        FontFamily="Segoe UI" FontSize="13" Foreground="#E8E2D6">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1A1815" />
        <SolidColorBrush x:Key="PanelLight" Color="#2A2621" />
        <SolidColorBrush x:Key="Accent" Color="#C9A45C" />
        <SolidColorBrush x:Key="OwnedBrush" Color="#5FAF6A" />
        <SolidColorBrush x:Key="MissingBrush" Color="#D2553F" />
        <SolidColorBrush x:Key="Muted" Color="#9A9286" />

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E2D6" />
            <Setter Property="Background" Value="{StaticResource PanelLight}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A342C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:ItemTileViewModel}">
            <Border x:Name="Tile" Width="96" Height="118" Margin="4" CornerRadius="6"
                    Background="{StaticResource PanelLight}" BorderThickness="2"
                    BorderBrush="{StaticResource MissingBrush}" ToolTip="{Binding Tooltip}"
                    Cursor="Hand" MouseLeftButtonUp="Tile_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Art" Margin="8,8,8,2">
                        <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Initials}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="11" Margin="4,0,4,6" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ManualMark" Text="✎" FontSize="11" Margin="0,3,5,0" Visibility="Collapsed"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Accent}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Owned}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource OwnedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Owned}" Value="False">
                    <Setter TargetName="Art" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsManual}" Value="True">
                    <Setter TargetName="ManualMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource Panel}" CornerRadius="8"
            BorderBrush="#3A342C" BorderThickness="1" Opacity="{Binding Value, ElementName=OpacitySlider}">
        <DockPanel Margin="10">

            <!-- Title bar: drag to move -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="REMNANT 2 OVERLAY" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding Summary}" Margin="12,0,0,0" Foreground="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0" />
                    <Slider x:Name="OpacitySlider" Width="80" Minimum="0.3" Maximum="1" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="—" Style="{StaticResource FlatButton}" Click="Minimize_Click" ToolTip="Hide (Ctrl+Shift+O to show)" />
                    <Button Content="✕" Style="{StaticResource FlatButton}" Margin="0" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Filters -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding CharacterNames}" SelectedIndex="{Binding CharacterIndex}" ToolTip="Character" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Label" />
                <ComboBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding World}" DisplayMemberPath="Label" MinWidth="130"
                          ToolTip="World. In manual mode, pick the adventure you rolled." />
                <ComboBox ItemsSource="{Binding ShowOptions}" SelectedItem="{Binding Show}" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,6,0"
                         Background="{StaticResource PanelLight}" Foreground="#E8E2D6" BorderThickness="0" Padding="4"
                         ToolTip="Search by item name or where it drops" />
            </WrapPanel>

            <!-- Status bar -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,14,0">
                    <ToggleButton Content="Manual mode" IsChecked="{Binding ManualMode}" Padding="10,4" Margin="0,0,6,0"
                                  ToolTip="Click tiles to mark them owned or missing yourself" />
                    <Button Content="Clear manual" Style="{StaticResource FlatButton}" Click="ClearManual_Click" />
                    <Button Content="Open save…" Style="{StaticResource FlatButton}" Click="OpenSave_Click" />
                    <Button Content="Reload" Style="{StaticResource FlatButton}" Click="Reload_Click" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource TileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
